#!/usr/bin/env bash
# Runs vboard from source (or npm) against a local board, sealed off from the factory's board, and drives it with vb.
#   verify-vboard up [--name N] [--ref <git ref> | --published <version> | --no-build] [--port P]
#                                  build vboard (this checkout, a ref in its own worktree, or a published version)
#                                  and serve a local board; prints its URL. --no-build takes this checkout's last build
#   verify-vboard vb [--name N] <vb args...>
#                                  run that vb against that board, logged to the run's transcript
#   verify-vboard doctor [--name N]   is the board up, ours, and running the version we built?
#   verify-vboard down [--name N]     stop that board and drop its worktree; the transcript and the log stay
# Every vb runs with only PATH and a home of its own: no VBOARD_URL, VBOARD_TOKEN, or GH_TOKEN, so nothing
# reaches the factory's board, and the board sees a person, not Pi. Runs live in VERIFY_VBOARD_DIR (/tmp/verify-vboard).
set -euo pipefail
ROOT="${VERIFY_VBOARD_DIR:-/tmp/verify-vboard}"

die() { echo "error: $*" >&2; exit 1; }

cmd="${1:-}"
[ -n "$cmd" ] && shift
name=default ref="" published="" port="" build=1
while [ $# -gt 0 ]; do
  case "$1" in
    --name) name="${2:?}"; shift 2 ;;
    --ref) ref="${2:?}"; shift 2 ;;
    --published) published="${2:?}"; shift 2 ;;
    --port) port="${2:?}"; shift 2 ;;
    --no-build) build=0; shift ;;
    *) break ;;
  esac
done
[[ "$name" =~ ^[a-z0-9][a-z0-9-]*$ ]] || die "--name takes lowercase letters, digits, and dashes"
RUN="$ROOT/$name"

# vb, as built for this run, with nothing from Pi's environment.
local_vb() {
  # From where it's called, so paths like `--attach ./shot.png` mean what they say; the board comes from VBOARD_URL.
  env -i PATH="$PATH" HOME="$RUN/home" TERM=dumb VBOARD_URL="$(cat "$RUN/url")" node "$(cat "$RUN/cli")" "$@"
}

alive() { [ -f "$RUN/pid" ] && kill -0 "$(cat "$RUN/pid")" 2>/dev/null; }

free_port() {
  node -e 'const s = require("net").createServer(); s.listen(0, "127.0.0.1", () => { console.log(s.address().port); s.close() })'
}

case "$cmd" in
  up)
    [ -n "$ref" ] && [ -n "$published" ] && die "pick one of --ref and --published"
    alive && die "run $name is already up at $(cat "$RUN/url"); verify-vboard down --name $name first"
    rm -rf "$RUN/home" "$RUN/work" "$RUN/board"
    mkdir -p "$RUN/home" "$RUN/work"
    : > "$RUN/transcript.txt"
    # The board's project: a scratch repo, so `vb serve` links it and not the checkout Pi works in.
    git -C "$RUN/work" init -q
    if [ -n "$published" ]; then
      echo "installing vboard@$published" >&2
      npm install --silent --prefix "$RUN/pkg" "vboard@$published" >"$RUN/build.log" 2>&1 || die "install failed, see $RUN/build.log"
      echo "$RUN/pkg/node_modules/vboard/dist/cli.mjs" > "$RUN/cli"
      echo "$published" > "$RUN/version"
    else
      repo=$(git rev-parse --show-toplevel 2>/dev/null) || die "run it inside the vboard checkout, or pass --published"
      src="$repo"
      if [ -n "$ref" ]; then
        git -C "$repo" fetch -q origin 2>/dev/null || true
        src="$RUN/src"
        [ -d "$src" ] && git -C "$repo" worktree remove --force "$src"
        git -C "$repo" worktree add -q --detach "$src" "$ref" || die "no ref $ref"
        echo "$repo" > "$RUN/worktree-of"
      fi
      if [ "$build" = 1 ] || [ -n "$ref" ]; then
        echo "building vboard in $src" >&2
        (cd "$src" && pnpm install --frozen-lockfile --filter vboard... && pnpm --filter vboard build) >"$RUN/build.log" 2>&1 \
          || die "build failed, see $RUN/build.log"
      fi
      [ -f "$src/packages/vboard/dist/cli.mjs" ] || die "vboard isn't built in $src: drop --no-build"
      echo "$src/packages/vboard/dist/cli.mjs" > "$RUN/cli"
      node -p "require('$src/packages/vboard/package.json').version" > "$RUN/version"
    fi
    port="${port:-$(free_port)}"
    rm -f "$RUN/pid"
    # The board writes its own pid: setsid may fork, so $! wouldn't be it.
    # Its output goes to serve.log as a whole, so nothing holds on to ours.
    (cd "$RUN/work" && exec env -i PATH="$PATH" HOME="$RUN/home" TERM=dumb PIDFILE="$RUN/pid" CLI="$(cat "$RUN/cli")" PORT="$port" BOARD="$RUN/board" \
      setsid nohup bash -c 'echo $$ > "$PIDFILE"; exec node "$CLI" serve --no-inspect --no-open --port "$PORT" --dir "$BOARD"') \
      >"$RUN/serve.log" 2>&1 </dev/null &
    for _ in $(seq 1 20); do [ -s "$RUN/pid" ] && break; sleep 0.1; done
    echo "http://127.0.0.1:$port/api/board" > "$RUN/url"
    for _ in $(seq 1 60); do
      if local_vb whoami >/dev/null 2>&1; then
        echo "board  $(cat "$RUN/url")"
        echo "vb     $(cat "$RUN/version")"
        echo "log    $RUN/transcript.txt"
        exit 0
      fi
      alive || break
      sleep 0.5
    done
    die "the board didn't start, see $RUN/serve.log"
    ;;

  vb)
    alive || die "run $name isn't up: verify-vboard up --name $name"
    printf '$ vb' >> "$RUN/transcript.txt"
    printf ' %q' "$@" >> "$RUN/transcript.txt"
    echo >> "$RUN/transcript.txt"
    set +e
    local_vb "$@" 2>&1 | tee -a "$RUN/transcript.txt"
    code=${PIPESTATUS[0]}
    set -e
    echo "[exit $code]" >> "$RUN/transcript.txt"
    exit "$code"
    ;;

  doctor)
    [ -d "$RUN" ] || die "no run $name"
    status=0
    if alive; then echo "board    up, pid $(cat "$RUN/pid")"; else echo "board    down"; status=1; fi
    want=$(cat "$RUN/version" 2>/dev/null || true)
    got=$(local_vb --version 2>/dev/null | head -1 || true)
    if [ -n "$got" ] && [ "$got" = "$want" ]; then echo "version  $got"; else echo "version  ${got:-none}, built ${want:-none}"; status=1; fi
    # Ours: the board answers on localhost, not the factory's.
    who=$(local_vb whoami 2>&1 || true)
    echo "whoami   $(head -1 <<<"$who")"
    grep -Eq "^board +http://127.0.0.1:" <<<"$who" || status=1
    exit "$status"
    ;;

  down)
    [ -d "$RUN" ] || die "no run $name"
    if alive; then
      kill "$(cat "$RUN/pid")"
      for _ in $(seq 1 20); do alive || break; sleep 0.25; done
      alive && kill -9 "$(cat "$RUN/pid")"
    fi
    rm -f "$RUN/pid"
    if [ -f "$RUN/worktree-of" ]; then
      git -C "$(cat "$RUN/worktree-of")" worktree remove --force "$RUN/src" 2>/dev/null || true
      rm -f "$RUN/worktree-of"
    fi
    echo "stopped $name; kept $RUN/transcript.txt and $RUN/board"
    ;;

  *)
    sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//' >&2
    exit 2
    ;;
esac
