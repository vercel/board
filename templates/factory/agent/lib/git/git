#!/bin/sh
# The sandbox's git (agent/sandbox.ts installs it ahead of /usr/bin/git). Every command runs the
# real git, except a push, which git-push.mjs sends through GitHub's API so GitHub signs it.
real=${GIT_REAL:-/usr/bin/git}
here=$(dirname "$(readlink -f "$0")")
skip=
for arg in "$@"; do
  if [ -n "$skip" ]; then skip=; continue; fi
  case $arg in
    -C | -c | --git-dir | --work-tree | --namespace) skip=1 ;;
    -*) ;;
    push) GIT_REAL=$real exec node "$here/git-push.mjs" "$@" ;;
    *) break ;;
  esac
done
exec "$real" "$@"
