#!/usr/bin/env bash
# Records the browser the agent drives (agent-browser, session "browser"), with a caption burned in for each step, narrated.
#   ui-demo start [--mute]                   start recording the browser's open tab
#   ui-demo step "<text>" [--voice <mp3>]    caption from now until the next step, and play <mp3> from now; waits
#                                            until it's been said (the narrate tool does this for each line)
#   ui-demo stop <out.mp4>                   stop, burn the captions in, add the voice, and fit the mp4 under 4 MB
# --mute records captions only.
set -euo pipefail
DIR="${UI_DEMO_DIR:-/tmp/ui-demo}"
SESSION="${UI_DEMO_SESSION:-browser}"
LIMIT=$((4 * 1000 * 1000))
# How long the take shows each step after its line is said: enough to see the action and its result.
HOLD="${UI_DEMO_HOLD:-4}"
# How long the last step stays on screen at least, when stop comes right after it.
LAST="${UI_DEMO_LAST:-2.5}"
now() { date +%s.%N; }
since_start() { awk -v a="$(cat "$DIR/start")" -v b="$(now)" 'BEGIN { printf "%.3f", b - a }'; }
browser() { agent-browser --session "$SESSION" "$@"; }

# The length of an audio file in seconds, from ffmpeg's header dump.
duration() {
  { ffmpeg -nostdin -hide_banner -i "$1" 2>&1 || true; } | awk -F'[:, ]+' '/Duration:/ { print $3 * 3600 + $4 * 60 + $5; exit }'
}

srt_time() { # seconds -> HH:MM:SS,mmm
  awk -v t="$1" 'BEGIN { if (t < 0) t = 0; ms = int(t * 1000 + 0.5);
    printf "%02d:%02d:%02d,%03d", int(ms / 3600000), int(ms / 60000) % 60, int(ms / 1000) % 60, ms % 1000 }'
}

case "${1:-}" in
  start)
    command -v ffmpeg >/dev/null || { echo "no ffmpeg in this sandbox, so no video: take a screenshot instead" >&2; exit 1; }
    # A take started over without stop: end its recording first.
    [ -f "$DIR/recording" ] && browser record stop >/dev/null 2>&1 || true
    rm -rf "$DIR" && mkdir -p "$DIR"
    shift
    for a in "$@"; do
      case "$a" in --mute) touch "$DIR/mute" ;; *) echo "usage: ui-demo start [--mute]" >&2; exit 1 ;; esac
    done
    # The tab the browser tools have open, as it is: open the page first.
    browser record start "$DIR/raw.mp4" --cursor --fps 24 > "$DIR/record.log" 2>&1 \
      || { echo "the recording didn't start (open the page with the browser first): $(cat "$DIR/record.log")" >&2; exit 1; }
    now > "$DIR/start"
    : > "$DIR/steps.tsv"
    touch "$DIR/recording"
    echo "recording the browser; narrate each step before its action"
    ;;
  step)
    [ -f "$DIR/recording" ] || { echo "not recording: run ui-demo start first" >&2; exit 1; }
    shift
    text="" clip=""
    while [ $# -gt 0 ]; do
      case "$1" in --voice) clip="${2:-}"; shift 2 ;; *) text="${text:+$text }$1"; shift ;; esac
    done
    [ -n "$text" ] || { echo "usage: ui-demo step \"<text>\" [--voice <mp3>]" >&2; exit 1; }
    at=$(since_start)
    printf '%s\t%s\n' "$at" "${text//$'\t'/ }" >> "$DIR/steps.tsv"
    [ -f "$DIR/mute" ] || [ -z "$clip" ] && exit 0
    # The line plays from when the step started; wait until it's been said, so the action follows it.
    n=$(wc -l < "$DIR/steps.tsv" | tr -d ' ')
    if [ -s "$clip" ] && len=$(duration "$clip") && [ -n "$len" ]; then
      mv "$clip" "$DIR/voice-$n.mp3"
      printf '%s\t%s\t%s\n' "$n" "$DIR/voice-$n.mp3" "$len" >> "$DIR/voice.tsv"
      left=$(awk -v at="$at" -v len="$len" -v now="$(since_start)" 'BEGIN { d = at + len - now; printf "%.3f", (d > 0 ? d : 0) }')
      sleep "$left"
    else
      echo "couldn't play the voice for \"$text\": it's captioned only" >&2
    fi
    ;;
  stop)
    out="${2:?usage: ui-demo stop <out.mp4>}"
    [ -f "$DIR/recording" ] || { echo "not recording: run ui-demo start first" >&2; exit 1; }
    # The last step usually comes right before stop: keep recording until it's been on screen for a moment.
    last=$(tail -n 1 "$DIR/steps.tsv" | cut -f 1)
    wait=$(awk -v l="${last:-0}" -v n="$(since_start)" -v h="$LAST" 'BEGIN { w = l + h - n; printf "%.3f", (w > 0 ? w : 0) }')
    sleep "$wait"
    end=$(since_start)
    rm -f "$DIR/recording"
    browser record stop >> "$DIR/record.log" 2>&1 || true
    [ -s "$DIR/raw.mp4" ] || { echo "the recording failed: $(cat "$DIR/record.log")" >&2; exit 1; }
    # The take keeps each step from its start while its line is said and for HOLD seconds more (the action and
    # what it did), and cuts the rest: the page sits still while the agent thinks. Captions and voice lines are
    # timed on the cut take, one per kept stretch.
    declare -A clips=() said=()
    if [ -s "$DIR/voice.tsv" ]; then
      while IFS=$'\t' read -r i clip len; do clips[$i]="$clip"; said[$i]="$len"; done < "$DIR/voice.tsv"
    fi
    n=0; cut=0; keep=""; audio=(); mix=""; voices=0
    : > "$DIR/captions.srt"
    mapfile -t lines < "$DIR/steps.tsv"
    for i in "${!lines[@]}"; do
      from="${lines[$i]%%$'\t'*}"; text="${lines[$i]#*$'\t'}"
      if [ $((i + 1)) -lt ${#lines[@]} ]; then next="${lines[$((i + 1))]%%$'\t'*}"; else next="$end"; fi
      to=$(awk -v a="$from" -v b="$next" -v h="$HOLD" -v s="${said[$((i + 1))]:-0}" 'BEGIN { printf "%.3f", (b < a + s + h) ? b : a + s + h }')
      len=$(awk -v a="$from" -v b="$to" 'BEGIN { printf "%.3f", b - a }')
      awk -v l="$len" 'BEGIN { exit !(l > 0.05) }' || continue
      n=$((n + 1))
      if [ -n "${clips[$((i + 1))]:-}" ]; then
        voices=$((voices + 1))
        audio+=(-i "${clips[$((i + 1))]}")
        mix+="[$voices:a]adelay=$(awk -v t="$cut" 'BEGIN { printf "%d", t * 1000 }'):all=1[v$voices];"
      fi
      keep="${keep:+$keep+}between(t\,$from\,$to)"
      printf '%d\n%s --> %s\n%s\n\n' "$n" "$(srt_time "$cut")" "$(srt_time "$(awk -v c="$cut" -v l="$len" 'BEGIN { print c + l }')")" "$text" >> "$DIR/captions.srt"
      cut=$(awk -v c="$cut" -v l="$len" 'BEGIN { printf "%.3f", c + l }')
    done
    [ -n "$keep" ] && trim="select=$keep,setpts=N/FRAME_RATE/TB," || { trim=""; cut="$end"; }
    if [ "$voices" -gt 0 ]; then
      for v in $(seq 1 "$voices"); do mix+="[v$v]"; done
      mix+="amix=inputs=$voices:normalize=0:duration=longest[a]"
      sound=(-filter_complex "$mix" -map 0:v -map "[a]" -c:a aac -b:a 64k -ac 1)
    else
      sound=(-an)
    fi
    style="FontName=Liberation Sans,FontSize=12,PrimaryColour=&H00FFFFFF,OutlineColour=&H40000000,BackColour=&H40000000,BorderStyle=3,Outline=4,Shadow=0,MarginV=16"
    # Smaller and blurrier each try until it fits under the board's 4 MB.
    for try in "1280 28" "1280 33" "960 35" "720 38"; do
      set -- $try
      ffmpeg -nostdin -loglevel error -y -i "$DIR/raw.mp4" "${audio[@]}" \
        -vf "${trim}scale='min($1,iw)':-2,subtitles=$DIR/captions.srt:force_style='$style'" \
        -c:v libx264 -preset veryfast -crf "$2" -pix_fmt yuv420p -movflags +faststart "${sound[@]}" "$out"
      size=$(stat -c %s "$out")
      if [ "$size" -le "$LIMIT" ]; then
        echo "$out: $((size / 1000)) KB, ${n} captions, ${voices} narrated, ${cut%.*}s (of ${end%.*}s recorded)"
        exit 0
      fi
    done
    echo "$out is still over 4 MB ($((size / 1000)) KB): record a shorter take" >&2
    exit 1
    ;;
  *)
    sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//'
    exit 1
    ;;
esac
