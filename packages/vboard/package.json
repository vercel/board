{
  "name": "vboard",
  "version": "0.13.0",
  "description": "A message board you mount in one route: one durable log, verified authors, live tail, and two-way sync.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "docs",
    "sql",
    "README.md"
  ],
  "bin": {
    "vboard": "./dist/cli.mjs",
    "vb": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./client": {
      "node": {
        "types": "./dist/client.node.d.mts",
        "default": "./dist/client.node.mjs"
      },
      "default": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      }
    },
    "./adapter-slack": {
      "types": "./dist/adapter-slack.d.mts",
      "default": "./dist/adapter-slack.mjs"
    },
    "./adapter-github": {
      "types": "./dist/adapter-github.d.mts",
      "default": "./dist/adapter-github.mjs"
    },
    "./adapter-kapso": {
      "types": "./dist/adapter-kapso.d.mts",
      "default": "./dist/adapter-kapso.mjs"
    },
    "./adapter-vercel-blob": {
      "types": "./dist/adapter-vercel-blob.d.mts",
      "default": "./dist/adapter-vercel-blob.mjs"
    },
    "./contract": {
      "types": "./dist/contract.d.mts",
      "default": "./dist/contract.mjs"
    },
    "./package.json": "./package.json",
    "./sync": {
      "types": "./dist/sync.d.mts",
      "default": "./dist/sync.mjs"
    },
    "./sync/chat": {
      "types": "./dist/sync.chat.d.mts",
      "default": "./dist/sync.chat.mjs"
    },
    "./store-postgres": {
      "types": "./dist/store-postgres.d.mts",
      "default": "./dist/store-postgres.mjs"
    },
    "./store-redis": {
      "types": "./dist/store-redis.d.mts",
      "default": "./dist/store-redis.mjs"
    },
    "./store-redis-http": {
      "types": "./dist/store-redis-http.d.mts",
      "default": "./dist/store-redis-http.mjs"
    },
    "./store-sqlite": {
      "types": "./dist/store-sqlite.d.mts",
      "default": "./dist/store-sqlite.mjs"
    },
    "./store-memory": {
      "types": "./dist/store-memory.d.mts",
      "default": "./dist/store-memory.mjs"
    },
    "./scheduler-vercel": {
      "types": "./dist/scheduler-vercel.d.mts",
      "default": "./dist/scheduler-vercel.mjs"
    },
    "./scheduler-qstash": {
      "types": "./dist/scheduler-qstash.d.mts",
      "default": "./dist/scheduler-qstash.mjs"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/schema.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "tsdown && node scripts/schema.ts",
    "pretest": "tsdown --log-level warn"
  },
  "dependencies": {
    "@chat-adapter/github": "^4.41.1",
    "@chat-adapter/slack": "^4.41.1",
    "@vercel/connect": "^2.3.4",
    "@vercel/oidc": "^3.8.9",
    "chat": "^4.41.1",
    "experimental-a2": "0.21.1",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@upstash/qstash": "^2.11.0",
    "@vercel/blob": "^2.8.0",
    "@vercel/queue": "*",
    "ioredis": "^5.4.0",
    "pg": "^8.11.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@chat-adapter/tests": "^4.41.1",
    "@electric-sql/pglite": "0.3.15",
    "@kapso/chat-adapter": "^0.1.1",
    "@types/node": "^26.6.3",
    "@types/pg": "8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/blob": "^2.8.0",
    "ai": "^7.0.130",
    "ioredis": "5.11.1",
    "lucide-react": "^1.49.0",
    "pg": "^8.16.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "peerDependenciesMeta": {
    "@upstash/qstash": {
      "optional": true
    },
    "@vercel/blob": {
      "optional": true
    },
    "@vercel/queue": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
