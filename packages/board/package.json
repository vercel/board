{
  "name": "@vercel/board",
  "version": "0.56.1",
  "description": "Your Vercel team's message board, for people and agents: one durable log, verified authors, live tail, and two-way sync.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vercel/board.git",
    "directory": "packages/board"
  },
  "homepage": "https://github.com/vercel/board#readme",
  "bugs": {
    "url": "https://github.com/vercel/board/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "bin": {
    "board": "./dist/cli.mjs",
    "vb": "./dist/cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "node": "./dist/index.node.mjs",
      "default": "./dist/index.mjs"
    },
    "./access": {
      "types": "./dist/access.d.mts",
      "default": "./dist/access.mjs"
    },
    "./schemas": {
      "types": "./dist/schemas.d.mts",
      "default": "./dist/schemas.mjs"
    },
    "./conformance": {
      "types": "./dist/conformance.d.mts",
      "default": "./dist/conformance.mjs"
    },
    "./cli": {
      "types": "./dist/cli-embedded.d.mts",
      "default": "./dist/cli-embedded.mjs"
    },
    "./cli/commands": {
      "types": "./dist/cli-commands.d.mts",
      "default": "./dist/cli-commands.mjs"
    },
    "./inspect": {
      "types": "./dist/inspect.d.mts",
      "default": "./dist/inspect.mjs"
    },
    "./backend-local": {
      "types": "./dist/backend-local.d.mts",
      "default": "./dist/backend-local.mjs"
    },
    "./sync": {
      "types": "./dist/sync.d.mts",
      "default": "./dist/sync.mjs"
    },
    "./sync-chat-sdk": {
      "types": "./dist/sync-chat-sdk.d.mts",
      "default": "./dist/sync-chat-sdk.mjs"
    },
    "./sync-slack": {
      "types": "./dist/sync-slack.d.mts",
      "default": "./dist/sync-slack.mjs"
    },
    "./sync-github": {
      "types": "./dist/sync-github.d.mts",
      "default": "./dist/sync-github.mjs"
    },
    "./sync-linear": {
      "types": "./dist/sync-linear.d.mts",
      "default": "./dist/sync-linear.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "tsdown",
    "pretest": "tsdown --log-level warn"
  },
  "dependencies": {
    "@vercel/oidc": "^3.8.9",
    "jose": "^6.2.12",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@chat-adapter/github": "^4.41.1",
    "@chat-adapter/linear": "^4.41.1",
    "@chat-adapter/slack": "^4.41.1",
    "@vercel/connect": "^2.3.4",
    "chat": "^4.41.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@chat-adapter/discord": "4.41.1",
    "@chat-adapter/github": "^4.41.1",
    "@chat-adapter/linear": "^4.41.1",
    "@chat-adapter/slack": "^4.41.1",
    "@chat-adapter/telegram": "4.41.1",
    "@chat-adapter/tests": "^4.41.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/connect": "^2.3.4",
    "ai": "^7.0.130",
    "ajv": "8.17.1",
    "ajv-formats": "2.1.1",
    "chat": "^4.41.1",
    "experimental-a2": "0.24.0",
    "github-slugger": "^2.0.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "@chat-adapter/github": {
      "optional": true
    },
    "@chat-adapter/linear": {
      "optional": true
    },
    "@chat-adapter/slack": {
      "optional": true
    },
    "@vercel/connect": {
      "optional": true
    },
    "chat": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
